# ---- Core ----
DATABASE_URL="postgresql://preci:preci@localhost:5432/preciops"
DIRECT_URL=""  # production only: the non-pooled URL used for migrations (see DEPLOY.md)
NEXTAUTH_URL="http://localhost:3000"   # production: https://app.preciopsatms.com
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3000"        # production: https://app.preciopsatms.com

# ---- Stripe billing ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."      # flat monthly, up to 3 users
STRIPE_PRICE_GROWTH="price_..."       # per user / month
STRIPE_PRICE_ENTERPRISE="price_..."   # per user / month (custom quotes via Stripe invoices)
# Employers (company type "Employer") are billed per active employee on every plan:
STRIPE_PRICE_STARTER_EMPLOYER="price_..."    # per employee / month
STRIPE_PRICE_GROWTH_EMPLOYER="price_..."     # per employee / month
STRIPE_PRICE_ENTERPRISE_EMPLOYER="price_..." # per employee / month
TRIAL_DAYS="14"

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="Preciops <notifications@mail.preciopsatms.com>"

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_MESSAGING_SERVICE_SID="MG..."

# ---- File storage (S3 or S3-compatible, e.g. Cloudflare R2) ----
STORAGE_DRIVER="s3"            # "local" stores files under .data/uploads (development only)
S3_BUCKET="preciops-files"
S3_REGION="us-east-1"
S3_ENDPOINT=""                 # leave blank for AWS
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# ---- AI ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
ANTHROPIC_ASSISTANT_MODEL="claude-opus-5-5"  # the in-app assistant (tool use); needs a model that supports effort

# ---- Scheduled jobs (Vercel Cron sends this as a Bearer token) ----
CRON_SECRET=""                 # openssl rand -hex 32

# ---- Error monitoring (optional) ----
SENTRY_DSN=""                  # https://<key>@o<org>.ingest.sentry.io/<project>

# ---- Shared rate limiting (optional; recommended with more than one server instance) ----
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---- Background checks (optional) ----
# Checkr partner program (email clients@checkr.com to register). Each company connects its own Checkr account.
# Register redirect_uri https://<your-app>/api/screening/checkr/callback and webhook_url https://<your-app>/api/webhooks/checkr
CHECKR_CLIENT_ID=""
CHECKR_CLIENT_SECRET=""
CHECKR_ENV="staging"           # "production" for live checks
# Single sign-on (Enterprise) through WorkOS (workos.com). Dashboard → API keys. Add the redirect URI
# https://<your-app>/api/auth/sso/callback under Redirects. Each company connects its own identity provider in Settings.
WORKOS_API_KEY=""
WORKOS_CLIENT_ID=""
CHECK_API_KEY=""               # Check (embedded payroll) partner API key; staffing firms then connect under Payroll → Payroll processing
CHECK_ENV="sandbox"            # "production" for live payroll
CHECK_WEBHOOK_SECRET=""        # Check webhook signing secret; webhook URL: https://<your-app>/api/webhooks/check
SECURITY_CONTACT_EMAIL=""      # where vulnerability reports go (shown on /security and /.well-known/security.txt); default security@preciopsatms.com

# ---- Accounting (optional) ----
# Redirect URIs to register: https://<your-app>/api/integrations/quickbooks/callback and .../xero/callback
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_ENV="sandbox"       # "production" for live companies
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
XERO_SALES_ACCOUNT="200"       # revenue account code for invoice lines
XERO_BANK_ACCOUNT=""           # bank account code for payments (leave blank to send invoices only)
INTEGRATIONS_KEY=""            # encrypts stored tokens; openssl rand -base64 32 (falls back to NEXTAUTH_SECRET)
