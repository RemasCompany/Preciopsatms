# ---- Core ----
DATABASE_URL="postgresql://preci:preci@localhost:5432/preciops"
NEXTAUTH_URL="http://localhost:3000"   # production: https://app.preciopsatms.com
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
APP_URL="http://localhost:3000"        # production: https://app.preciopsatms.com

# ---- Stripe billing ----
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."      # flat monthly, up to 3 users
STRIPE_PRICE_GROWTH="price_..."       # per user / month
STRIPE_PRICE_ENTERPRISE="price_..."   # per user / month (custom quotes via Stripe invoices)
TRIAL_DAYS="14"

# ---- Email (Resend) ----
RESEND_API_KEY="re_..."
EMAIL_FROM="Preciops <notifications@mail.preciopsatms.com>"

# ---- SMS (Twilio) ----
TWILIO_ACCOUNT_SID="AC..."
TWILIO_AUTH_TOKEN="..."
TWILIO_MESSAGING_SERVICE_SID="MG..."

# ---- File storage (S3 or S3-compatible, e.g. Cloudflare R2) ----
S3_BUCKET="preciops-files"
S3_REGION="us-east-1"
S3_ENDPOINT=""                 # leave blank for AWS
S3_ACCESS_KEY_ID="..."
S3_SECRET_ACCESS_KEY="..."

# ---- AI ----
ANTHROPIC_API_KEY="sk-ant-..."
ANTHROPIC_MODEL="claude-sonnet-5"
