// Preciops data model. Every business table carries organizationId (tenant key).
// Tenant isolation is enforced in code by src/lib/tenant.ts (tenantDb), never by trusting client input.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------- Tenancy, users, billing ----------------

enum Role {
  OWNER
  ADMIN
  RECRUITER
  VIEWER
}

enum PlanId {
  starter
  growth
  enterprise
}

model Organization {
  id                   String    @id @default(cuid())
  name                 String
  slug                 String    @unique // used in public careers URLs
  shortName            String?
  ownerName            String?
  ownerTitle           String?
  city                 String?
  website              String?
  services             String?
  pitch                String?
  logoUrl              String?
  brandColor           String    @default("#0E7A6E")
  applyEmail           String?
  careersHeadline      String    @default("Find your next role")
  careersIntro         String?
  showPayOnCareers     Boolean   @default(true)
  showClientOnCareers  Boolean   @default(false)
  payrollProvider      String?   // adp | paychex | quickbooks | gusto | csv: default export format
  payrollCompanyCode   String?   // company code some providers need in imports (e.g. ADP Co Code)
  timezone             String    @default("America/New_York") // IANA zone for time clock days and workweeks
  onboardingEnabled    Boolean   @default(true)    // the company can switch onboarding off (e.g. direct-hire only)
  onboardingEnforcement String   @default("warn")  // warn | block: unfinished onboarding blocks scheduling and clock-in
  birthdayGreetings    Boolean   @default(false)   // send workers on assignment a greeting on their birthday
  // Billing
  plan                 PlanId    @default(starter)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String    @default("trialing") // mirrors Stripe: trialing|active|past_due|canceled|unpaid|incomplete
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  seats                Int       @default(1)
  salesTargets         SalesTarget[]
  credentials          Credential[]
  shifts               Shift[]
  workerLinks          WorkerLink[]
  payrollRuns          PayrollRun[]
  timeEntries          TimeEntry[]
  onboardingPackages   OnboardingPackage[]
  onboardings          Onboarding[]
  feedback             Feedback[]
  feedbackRequests     FeedbackRequest[]
  recognitions         Recognition[]
  aiCreditsUsed        Int       @default(0) // reset each billing period by webhook
  // Indeed Apply (candidates apply on Indeed; Indeed POSTs applications to /api/public/<slug>/indeed-apply)
  indeedApplyApiToken  String?
  indeedApplySecret    String?   // shared secret for X-Indeed-Signature; never returned to the browser
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  members      Membership[]
  invites      Invite[]
  jobs         Job[]
  candidates   Candidate[]
  applications Application[]
  clients      Client[]
  contacts     Contact[]
  deals        Deal[]
  leads        Lead[]
  vendors      Vendor[]
  tasks        Task[]
  timesheets   Timesheet[]
  documents    SignDocument[]
  messages     Message[]
  eeo          EeoSelfId[]
  activity     Activity[]
  files        StoredFile[]
  auditLogs          AuditLog[]
  backgroundTasks    BackgroundTask[]
  invoices           Invoice[]
  invoiceLines       InvoiceLine[]
  payments           Payment[]
  clientPortalLinks  ClientPortalLink[]
  openShifts         OpenShift[]
  shiftOffers        ShiftOffer[]
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String?
  passwordHash String
  emailVerifiedAt   DateTime?
  passwordChangedAt DateTime?  // sessions issued before this are signed out
  createdAt    DateTime     @default(now())
  memberships  Membership[]
  authTokens   AuthToken[]
}

// One-time links for password reset and email verification. Only the hash is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  kind      String    // reset | verify
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

model Membership {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           Role         @default(RECRUITER)
  createdAt      DateTime     @default(now())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
}

model Invite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           Role         @default(RECRUITER)
  tokenHash      String       @unique
  expiresAt      DateTime
  acceptedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------- Recruiting ----------------

enum JobStatus {
  OPEN
  ON_HOLD
  FILLED
  CLOSED
}

enum EmploymentType {
  CONTRACT
  CONTRACT_TO_HIRE
  DIRECT_HIRE
  TEMP
  PER_DIEM
}

model Job {
  id             String         @id @default(cuid())
  organizationId String
  clientId       String?
  title          String
  sector         String?
  location       String?        // "City, ST" — job boards need city and state for organic visibility
  postalCode     String?
  remote         Boolean        @default(false) // fully remote: Google for Jobs TELECOMMUTE
  type           EmploymentType @default(CONTRACT)
  openings       Int            @default(1)
  payRate        Decimal?       @db.Decimal(10, 2)
  billRate       Decimal?       @db.Decimal(10, 2)
  status         JobStatus      @default(OPEN)
  hot            Boolean        @default(false)
  startDate      DateTime?
  skills         String[]
  description    String?
  posting        String?        // public-facing posting text
  applyUrl       String?        // optional external apply link; default is the built-in apply form
  publish        Boolean        @default(true) // show on public careers page / feeds
  postedTo       Json?          // { "Indeed": "2026-09-27", ... }
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  applications   Application[]

  @@index([organizationId, status])
  openShifts     OpenShift[]
}

model Candidate {
  id             String        @id @default(cuid())
  organizationId String
  vendorId       String?
  name           String
  email          String?
  phone          String?
  title          String?
  location       String?
  sector         String?
  yearsExp       Int?
  desiredRate    Decimal?      @db.Decimal(10, 2)
  availability   String?
  source         String?
  status         String        @default("Active")
  skills         String[]
  certs          String[]
  summary        String?
  payrollId      String?       // employee ID in the payroll provider, used to match export rows
  birthMonth     Int?          // month and day only (never the year) — for workers on assignment; never used in matching
  birthDay       Int?
  lastGreetedYear Int?         // year of the last birthday greeting sent
  resumeFileId   String?
  emailOptOut    Boolean       @default(false)
  smsOptOut      Boolean       @default(false) // set by Twilio STOP webhook (TCPA)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor         Vendor?       @relation(fields: [vendorId], references: [id], onDelete: SetNull)
  workerLinks    WorkerLink[]
  credentials    Credential[]
  applications   Application[]

  @@index([organizationId, email])
  @@index([organizationId, phone])
}

enum Stage {
  APPLIED
  SOURCED
  SCREENED
  SUBMITTED
  INTERVIEW
  OFFER
  PLACED
  REJECTED
}

model Application {
  id               String       @id @default(cuid())
  organizationId   String
  candidateId      String
  jobId            String
  stage            Stage        @default(SOURCED)
  maxStage         Stage        @default(SOURCED) // furthest stage reached, for EEO applicant-flow reporting
  rejectionReason  String?      // required when stage = REJECTED
  matchScore       Int?
  stageChangedAt   DateTime     @default(now())
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate        Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  onboardings      Onboarding[]
  timeEntries      TimeEntry[]
  shifts           Shift[]
  timesheets       Timesheet[]

  @@unique([candidateId, jobId])
  @@index([organizationId, stage])
}

// Voluntary self-identification. Separate table; readable only by OWNER/ADMIN.
model EeoSelfId {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String       @unique
  gender         String?
  race           String?
  veteran        String?
  disability     String?
  collectedAt    DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------- Sales / CRM ----------------

model Client {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  industry       String?
  status         String       @default("Active")
  city           String?
  website        String?
  markupPct      Decimal?     @db.Decimal(5, 2)
  msaSignedAt    DateTime?
  paymentTerms   String       @default("Net 30")
  onboardingMode      String   @default("ask") // ask (recruiter picks) | package (always onboardingPackageId) | none (not required)
  onboardingPackageId String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       Contact[]
  jobs           Job[]
  deals          Deal[]
  invoices       Invoice[]
}

model Contact {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String
  name           String
  title          String?
  email          String?
  phone          String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  portalLinks    ClientPortalLink[]
}

model Deal {
  id             String       @id @default(cuid())
  organizationId String
  clientId       String?
  title          String
  value          Decimal?     @db.Decimal(12, 2)
  stage          String       @default("Prospect") // Prospect|Qualified|Proposal|Negotiation|Won|Lost
  closeDate      DateTime?    // expected close
  closedAt       DateTime?    // when it was actually marked Won or Lost
  stageChangedAt DateTime     @default(now())
  ownerId        String?      // sales rep (User); null = unassigned
  service        String?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
}

model Lead {
  id             String       @id @default(cuid())
  organizationId String
  company        String
  contact        String?
  role           String?
  email          String?
  phone          String?
  industry       String?
  size           String?
  city           String?
  source         String?
  status         String       @default("New")
  ownerId        String?      // sales rep (User); null = unassigned
  convertedAt    DateTime?
  score          Int?
  nextStepAt     DateTime?
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// ---------------- Operations ----------------

model Vendor {
  id                 String       @id @default(cuid())
  organizationId     String
  name               String
  category           String?
  status             String       @default("Pending")
  contact            String?
  email              String?
  phone              String?
  sectors            String[]
  feePct             Decimal?     @db.Decimal(5, 2)
  rating             Decimal?     @db.Decimal(2, 1)
  coiExpiresAt       DateTime?
  w9ReceivedAt       DateTime?
  agreementExpiresAt DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidates         Candidate[]
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  title          String
  dueAt          DateTime?
  priority       String       @default("Normal")
  related        String?
  done           Boolean      @default(false)
  assigneeId     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum TimesheetStatus {
  DRAFT
  APPROVED
  PAID
}

model Timesheet {
  id             String          @id @default(cuid())
  organizationId String
  applicationId  String
  weekEnding     DateTime        @db.Date
  regularHours   Decimal         @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal         @default(0) @db.Decimal(6, 2)
  payRate        Decimal         @db.Decimal(10, 2) // snapshot at entry
  billRate       Decimal         @db.Decimal(10, 2) // snapshot at entry
  status         TimesheetStatus @default(DRAFT)
  payrollRunId   String?         // the non-void payroll run that includes these hours
  clientApprovedAt DateTime?     // the client signed off on these hours in the client portal
  clientApprovedBy String?       // contact name, as they appeared then
  clientDisputeNote String?      // the client questioned these hours (cleared when they approve)
  clientDisputedAt  DateTime?
  approvedAt     DateTime?
  approvedById   String?
  paidAt         DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application     @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@unique([applicationId, weekEnding])
  @@index([organizationId, weekEnding])
}

enum SignStatus {
  DRAFT
  SENT
  SIGNED
  COUNTERSIGNED
  VOID
}

model SignDocument {
  id              String       @id @default(cuid())
  organizationId  String
  type            String       // offer|assignment|vendor|client|custom
  title           String
  body            String
  relatedType     String       // candidate|vendor|client
  relatedId       String
  signerName      String
  signerEmail     String
  status          SignStatus   @default(DRAFT)
  tokenHash       String?      @unique // sha256 of the one-time signing token; raw token only ever lives in the emailed link
  tokenExpiresAt  DateTime?
  bodySha256      String?      // fingerprint of the exact text signed
  signerSignature String?      // PNG data URL
  signedAt        DateTime?
  signerIp        String?
  signerUserAgent String?
  counterName     String?
  counterSignature String?
  counterSignedAt DateTime?
  pdfFileId       String?
  audit           Json         @default("[]")
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model Message {
  id             String       @id @default(cuid())
  organizationId String
  channel        String       // email|sms
  toAddress      String
  subject        String?
  body           String
  relatedType    String?
  relatedId      String?
  status         String       @default("queued") // queued|sent|failed|blocked_opt_out
  providerId     String?
  error          String?
  sentById       String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, relatedType, relatedId])
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
}

/// A client invoice built from approved hours. Lines snapshot the hours and bill rates; each timesheet is billed once.
model Invoice {
  id             String        @id @default(cuid())
  organizationId String
  clientId       String
  number         String
  status         InvoiceStatus @default(DRAFT)
  issueDate      DateTime      @db.Date
  dueDate        DateTime      @db.Date
  periodStart    DateTime      @db.Date
  periodEnd      DateTime      @db.Date
  terms          String
  total          Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @db.Decimal(12, 2)
  notes          String?
  sentAt         DateTime?
  sentTo         String?
  paidAt         DateTime?
  voidedAt       DateTime?
  voidReason     String?
  payrollRunId   String?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client        @relation(fields: [clientId], references: [id], onDelete: NoAction) // invoices are financial records: a client with invoices can't be deleted
  lines          InvoiceLine[]
  payments       Payment[]

  @@unique([organizationId, number])
  @@index([organizationId, status, dueDate])
  @@index([organizationId, clientId])
}

model InvoiceLine {
  id             String       @id @default(cuid())
  organizationId String
  invoiceId      String
  timesheetId    String?
  worker         String
  description    String
  weekEnding     DateTime?    @db.Date
  regularHours   Decimal      @default(0) @db.Decimal(6, 2)
  overtimeHours  Decimal      @default(0) @db.Decimal(6, 2)
  rate           Decimal      @db.Decimal(10, 2)
  amount         Decimal      @db.Decimal(12, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, timesheetId])
  @@index([invoiceId])
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  invoiceId      String
  amount         Decimal      @db.Decimal(12, 2)
  receivedOn     DateTime     @db.Date
  method         String       // ach | check | card | wire | other
  reference      String?
  notes          String?
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([organizationId, receivedOn])
  @@index([invoiceId])
}

/// A shift nobody is on yet, offered to the job's worker pool; the first to accept gets it.
model OpenShift {
  id             String       @id @default(cuid())
  organizationId String
  jobId          String
  date           DateTime     @db.Date
  start          String
  end            String
  breakMinutes   Int          @default(0)
  unit           String?
  notes          String?
  slots          Int          @default(1)
  filled         Int          @default(0)
  status         String       @default("OPEN") // OPEN | FILLED | CANCELLED
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job            Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  offers         ShiftOffer[]

  @@index([organizationId, date])
}

model ShiftOffer {
  id             String       @id @default(cuid())
  organizationId String
  openShiftId    String
  candidateId    String
  applicationId  String
  status         String       @default("OFFERED") // OFFERED | ACCEPTED | DECLINED | TAKEN | CANCELLED
  sentAt         DateTime     @default(now())
  sentVia        String?
  respondedAt    DateTime?
  shiftId        String?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  openShift      OpenShift    @relation(fields: [openShiftId], references: [id], onDelete: Cascade)

  @@unique([openShiftId, candidateId])
  @@index([organizationId, candidateId, status])
}

/// A client contact's private link to the client portal. Long-lived, revocable; only the hash is stored.
model ClientPortalLink {
  id             String       @id @default(cuid())
  organizationId String
  contactId      String
  tokenHash      String       @unique
  expiresAt      DateTime
  revokedAt      DateTime?
  lastUsedAt     DateTime?
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contact        Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([organizationId, contactId])
}

/// Work that runs outside the request (bulk messaging, …). Claimed with SKIP LOCKED so two workers never run the same task.
model BackgroundTask {
  id             String       @id @default(cuid())
  organizationId String
  kind           String
  payload        Json
  status         String       @default("queued") // queued | running | done | failed
  attempts       Int          @default(0)
  maxAttempts    Int          @default(3)
  runAt          DateTime     @default(now())
  lockedAt       DateTime?
  progress       Json?
  result         Json?
  lastError      String?
  createdById    String?
  createdAt      DateTime     @default(now())
  finishedAt     DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
  @@index([organizationId, createdAt])
}

/// Append-only record of admin and security-sensitive actions. Never updated or deleted by the app.
model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  actorId        String?
  actorEmail     String?
  action         String
  summary        String
  targetType     String?
  targetId       String?
  changes        Json?
  ip             String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  text           String
  actorId        String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
}

model StoredFile {
  id             String       @id @default(cuid())
  organizationId String
  key            String       @unique // S3 object key, always prefixed by organizationId
  filename       String
  contentType    String
  size           Int
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

// Monthly revenue quota per sales rep. month is the first day of the month (UTC).
model SalesTarget {
  id             String       @id @default(cuid())
  organizationId String
  userId         String
  month          DateTime     @db.Date
  amount         Decimal      @db.Decimal(12, 2)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, month])
}

// A license, certification, health record or screening on file for a candidate (healthcare compliance).
// Verification is cleared whenever the number, state or dates change, so a renewal must be re-verified.
model Credential {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  type           String
  name           String?      // for type "Other", or a specialty (e.g. "Med-Surg")
  number         String?
  state          String?      // issuing state, two letters
  issuedAt       DateTime?    @db.Date
  expiresAt      DateTime?    @db.Date
  verifiedAt     DateTime?
  verifiedById   String?
  verifyMethod   String?
  verifyNote     String?
  fileId         String?
  alertedLevel   Int?         // smallest alert window already emailed (60, 30, 7, 0 = expired)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([candidateId])
}

enum ShiftResponse {
  PENDING
  CONFIRMED
  DECLINED
}

// One scheduled shift for a worker on assignment. Times are local to the job site ("07:00"); an end at or
// before the start runs past midnight. Workers only hear about a shift when the schedule is published.
model Shift {
  id             String        @id @default(cuid())
  organizationId String
  applicationId  String
  date           DateTime      @db.Date
  start          String
  end            String
  breakMinutes   Int           @default(0)
  unit           String?       // unit, department or post
  notes          String?
  cancelled      Boolean       @default(false)
  notified       Boolean       @default(false) // the worker has been told about this version of the shift
  notifiedAt     DateTime?     // last notice sent; null = the worker has never heard about it
  response       ShiftResponse @default(PENDING)
  respondedAt    DateTime?
  declineReason  String?
  remindedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@index([applicationId, date])
}

// Private link a worker gets in schedule notices to see and confirm their shifts. Only the hash is stored.
model WorkerLink {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  tokenHash      String       @unique
  expiresAt      DateTime
  kind           String       @default("schedule") // schedule | timeclock (long-lived, sent on purpose, revocable)
  revokedAt      DateTime?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate      Candidate    @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId])
}

enum PayrollRunStatus {
  DRAFT
  APPROVED
  PAID
  VOID
}

enum PayrollAdjustmentKind {
  BONUS          // taxable
  OTHER_EARNING  // taxable (e.g. shift differential, holiday pay)
  REIMBURSEMENT  // not taxable (mileage, scrubs, parking)
  DEDUCTION      // after-tax (e.g. advance repayment, uniform)
}

// A pay run for one pay period: approved timesheets are snapshotted into items. Taxes, direct deposit and filings
// happen in the agency's payroll provider, which imports the run's export.
model PayrollRun {
  id             String           @id @default(cuid())
  organizationId String
  number         String
  frequency      String           // WEEKLY | BIWEEKLY
  periodStart    DateTime         @db.Date
  periodEnd      DateTime         @db.Date // a Sunday
  payDate        DateTime         @db.Date
  status         PayrollRunStatus @default(DRAFT)
  notes          String?
  createdById    String?
  approvedById   String?
  approvedAt     DateTime?
  paidAt         DateTime?
  voidedAt       DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          PayrollItem[]

  @@unique([organizationId, number])
  @@index([organizationId, periodEnd])
}

// One approved timesheet (one worker, one assignment, one week) in a run, with names and rates snapshotted.
model PayrollItem {
  id             String              @id @default(cuid())
  organizationId String
  runId          String
  timesheetId    String
  applicationId  String
  candidateId    String
  workerName     String
  payrollId      String?
  position       String
  clientId       String?
  clientName     String?
  weekEnding     DateTime            @db.Date
  regularHours   Decimal             @db.Decimal(6, 2)
  overtimeHours  Decimal             @db.Decimal(6, 2)
  payRate        Decimal             @db.Decimal(10, 2)
  billRate       Decimal             @db.Decimal(10, 2)
  regularPay     Decimal             @db.Decimal(12, 2)
  overtimePay    Decimal             @db.Decimal(12, 2)
  createdAt      DateTime            @default(now())
  run            PayrollRun          @relation(fields: [runId], references: [id], onDelete: Cascade)
  adjustments    PayrollAdjustment[]

  @@index([runId])
  @@index([organizationId, candidateId])
}

model PayrollAdjustment {
  id             String                @id @default(cuid())
  organizationId String
  itemId         String
  kind           PayrollAdjustmentKind
  description    String
  amount         Decimal               @db.Decimal(12, 2)
  createdById    String?
  createdAt      DateTime              @default(now())
  item           PayrollItem           @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// One clock-in to clock-out for a worker on an assignment. Times are instants (UTC); the org's time zone decides
// which day and workweek they fall in. Edits by staff keep the original punches and a reason.
model TimeEntry {
  id               String       @id @default(cuid())
  organizationId   String
  applicationId    String
  shiftId          String?      // the scheduled shift this punch matched, if any
  clockIn          DateTime
  clockOut         DateTime?
  breakMinutes     Int          @default(0)
  breakStartedAt   DateTime?
  source           String       @default("WORKER") // WORKER | STAFF
  inLat            Float?
  inLng            Float?
  inAccuracy       Float?
  outLat           Float?
  outLng           Float?
  outAccuracy      Float?
  note             String?
  originalClockIn  DateTime?
  originalClockOut DateTime?
  editedById       String?
  editedAt         DateTime?
  editReason       String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application      Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([organizationId, clockIn])
  @@index([applicationId, clockIn])
}

// A reusable new-hire checklist (e.g. "Healthcare new hire"). Steps are JSON validated by src/lib/onboarding.ts.
model OnboardingPackage {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  description    String?
  steps          Json         @default("[]")
  archived       Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

enum OnboardingStatus {
  IN_PROGRESS
  COMPLETE
  CANCELLED
}

// One new hire working through a package for one assignment. Steps are copied from the package when it starts.
model Onboarding {
  id             String           @id @default(cuid())
  organizationId String
  applicationId  String
  candidateId    String
  packageId      String?
  packageName    String
  status         OnboardingStatus @default(IN_PROGRESS)
  startDate      DateTime?        @db.Date
  invitedAt      DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  application    Application      @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  steps          OnboardingStep[]

  @@index([organizationId, status])
  @@index([candidateId])
}

enum OnboardingStepStatus {
  PENDING
  DONE
  WAIVED
}

model OnboardingStep {
  id             String               @id @default(cuid())
  organizationId String
  onboardingId   String
  position       Int
  kind           String               // SIGN | UPLOAD | FORM | STAFF | CREDENTIAL
  label          String
  hint           String?
  required       Boolean              @default(true)
  config         Json                 @default("{}")
  status         OnboardingStepStatus @default(PENDING)
  completedAt    DateTime?
  completedBy    String?              // "worker" or a user id
  note           String?
  signDocumentId String?
  fileId         String?
  data           Json?                // form answers (emergency contact)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  onboarding     Onboarding           @relation(fields: [onboardingId], references: [id], onDelete: Cascade)

  @@index([onboardingId])
  @@index([signDocumentId])
}

// How an assignment is going: from the worker (pulse check), the client (rating link) or staff (e.g. a phone call).
model Feedback {
  id             String       @id @default(cuid())
  organizationId String
  candidateId    String
  applicationId  String?
  source         String       // WORKER | CLIENT | STAFF
  rating         Int          // 1–5
  wouldRehire    Boolean?     // client: would you have them back?
  comment        String?
  authorName     String?      // client contact's name, as typed
  contactId      String?
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([candidateId])
}

// A one-time link a client contact uses to rate a worker. Only the hash is stored.
model FeedbackRequest {
  id             String       @id @default(cuid())
  organizationId String
  applicationId  String
  contactId      String
  tokenHash      String       @unique
  expiresAt      DateTime
  completedAt    DateTime?
  feedbackId     String?
  createdById    String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([applicationId])
}

// Kudos for a worker from staff (or a milestone), optionally sent to them and shown on their page.
model Recognition {
  id              String       @id @default(cuid())
  organizationId  String
  candidateId     String
  applicationId   String?
  kind            String       // attendance | client_praise | above_beyond | safety | milestone | other
  message         String
  visibleToWorker Boolean      @default(true)
  notifiedAt      DateTime?
  createdById     String?
  createdAt       DateTime     @default(now())
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([candidateId])
}
